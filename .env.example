# =============================================================================
# Dashboard publico de ranking — Encuentro Smart Cyber Junio
# =============================================================================
# Este frontend es 100% publico: NO usa credenciales de Supabase. Consume el
# endpoint de ored que aplica CORS + cache + shape seguro.

# URL base del endpoint publico de ored.
# Local:      http://localhost:3000
# Producción: https://ored.cl
VITE_API_BASE_URL=https://ored.cl

# Periodo del Cyber (ISO 8601). El frontend los manda al endpoint como
# ?desde=...&hasta=... — el backend NO los hardcodea para reusabilidad.
VITE_CYBER_DESDE=2026-05-15T00:00:00-04:00
VITE_CYBER_HASTA=2026-07-15T23:59:59-04:00

# Branding
VITE_EVENTO_NOMBRE=Encuentro Smart
VITE_EVENTO_SUBTITULO=Cyber Junio 2026
