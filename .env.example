# Origen de datos del dashboard: ored (default) | atlas | supabase | mock
# ored es la fuente autoritativa del ranking: trae avatares y, desde la migracion
# 128, el estado de la reserva, con lo que las caidas se descuentan solas.
#
# NO usar atlas para la competencia: clasifica distinto. En la ventana Cyber ve
# 475 reservas y marca 71 caidas, donde ored ve 416 y marca 84; las que ored da
# por canceladas Atlas las reporta como Pendiente y terminan sumando puntos.
# VITE_DATA_SOURCE=ored

# Proxy de Atlas. Opcional: si SUPABASE_URL esta definido, la URL se arma sola.
# VITE_ATLAS_PROXY_URL=https://<PROJECT>.supabase.co/functions/v1/reservas-atlas
#
# La credencial de Atlas NO va aca ni en ningun archivo del repo: es un secreto de
# la Edge Function (ATLAS_API_KEY). Da acceso a datos personales de clientes y todo
# lo que lleve prefijo VITE_ o SUPABASE_ queda expuesto en el bundle publico.

# Dashboard: auto-refresh API (ms). 0 o vacío = fijo hasta pulsar Actualizar. Mínimo 5000 si se activa.
# VITE_DASHBOARD_POLL_MS=0

# Dashboard admin — Supabase (solo si VITE_DATA_SOURCE=supabase o auth admins)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dashboard admin — Capital Open
VITE_CAPITAL_OPEN_NOMBRE=Capital Open
VITE_CAPITAL_OPEN_SUBTITULO=Cyber Junio
VITE_CAPITAL_OPEN_LOGO=CO
VITE_CAPITAL_OPEN_LOGO_URL=/capital-open-logo.png
VITE_CYBER_FECHA_DESDE=2026-05-15
VITE_CYBER_FECHA_HASTA=2026-07-15

# Ranking publico /cyber — API ored (reservas) + Supabase (puntos manuales, opcion B)
# En `npm run dev` las peticiones van por proxy local (/api → ored.cl).
# En build/produccion se usa esta URL directamente.
# /cyber tambien requiere SUPABASE_URL y SUPABASE_ANON_KEY para promesas/escrituras.
VITE_API_BASE_URL=https://ored.cl
VITE_CYBER_DESDE=2026-05-15T00:00:00-04:00
VITE_CYBER_HASTA=2026-07-15T23:59:59-04:00
VITE_EVENTO_NOMBRE=Capital Open
VITE_EVENTO_SUBTITULO=Cyber Junio 2026

# Ranking publico /cyber: intervalo de auto-refresh (ms). Minimo 5000. Default 30 min.
VITE_CYBER_POLL_MS=1800000

# Ranking publico /cyber: modo suspenso. true = oculta TODAS las cifras (puntos,
# reservas, promesas, escrituras, cartera UF) y el orden real (reordena
# alfabetico, sin posiciones ni medallas); solo se ven avatar y nombre. false
# (default) = ranking normal por puntos.
# Reversible: cambiar a false y redesplegar el dia del anuncio.
# VITE_RANKING_SUSPENSO=false

# Puntos manuales competencia (promesas/escrituras): sync Supabase para /cyber (ms). Default 15 s.
# Requiere tabla encuentro_competencia_manual (ver docs/supabase-competencia-manual.sql).
VITE_CYBER_MANUAL_POLL_MS=15000

# Opcional: admins competencia (correos separados por coma)
# VITE_ADMIN_EMAILS=

# Datos de cliente en la pestana Reservas (nombre, RUT, correo, telefono).
# Los ve cualquier cuenta con sesion iniciada. Requiere desplegar la Edge Function
# reservas-privado con el secreto ORED_API_KEY.
# OJO: como basta con tener sesion, VITE_ADMIN_EMAILS pasa a ser el control de
# acceso real. Si queda vacio, cualquier correo puede registrarse por OTP y ver
# datos personales de clientes. Definelo siempre.
# La API key de ored NO va aca: quedaria expuesta en el bundle publico.
# Opcional, solo si la funcion vive en otro host:
# VITE_RESERVAS_PRIVADO_URL=https://<PROJECT>.supabase.co/functions/v1/reservas-privado
# Ver docs/DEPLOY-reservas-privado.md

# Google Forms → asistencia (Supabase Edge Function forms-asistencia)
# Apps Script: WEBHOOK_URL=https://<PROJECT>.supabase.co/functions/v1/forms-asistencia
# Solo en Supabase secrets (nunca en VITE_*): FORMS_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY
# FORMS_WEBHOOK_SECRET=
# Poll asistencias en dashboard (ms). Default 30000.
# VITE_ASISTENCIA_POLL_MS=30000
